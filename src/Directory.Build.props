<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by every SolTechnology.DataLake package: one version, one licence. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0-preview.1</Version>
    <Authors>Adrian Strugala</Authors>
    <Company>SolTechnology</Company>
    <Product>SolTechnology.DataLake</Product>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/Sol-Technology/SolTechnology.DataLake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Sol-Technology/SolTechnology.DataLake</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LicenceSummary>Free for noncommercial use and for companies under 100 people / 1M USD revenue (PolyForm Noncommercial / Small Business); commercial licence for other organisations - see LICENSE.md.</LicenceSummary>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" Visible="false" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE.md" Pack="true" Visible="false" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../licenses/PolyForm-Noncommercial-1.0.0.md" Pack="true" Visible="false" PackagePath="licenses\" />
    <None Include="$(MSBuildThisFileDirectory)../licenses/PolyForm-Small-Business-1.0.0.md" Pack="true" Visible="false" PackagePath="licenses\" />
  </ItemGroup>
</Project>
