<Project>
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <!-- Shared by every SolTechnology.DataLake package in this repository: one version, MIT. A package with other terms sets its own licence. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Version>0.2.0-preview.1</Version>
    <Authors>Adrian Strugala</Authors>
    <Company>SolTechnology</Company>
    <Product>SolTechnology.DataLake</Product>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Sol-Technology/SolTechnology.DataLake</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Sol-Technology/SolTechnology.DataLake</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <LicenceSummary>MIT licence.</LicenceSummary>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" Visible="false" PackagePath="\" />
    <None Include="$(MSBuildThisFileDirectory)../LICENSE.md" Pack="true" Visible="false" PackagePath="\" />
    <!-- Navy tile like AvroConvert, DateTimeZone and Core; generated by scripts/brand-datalake.py in sol-technology.github.io. -->
    <None Include="$(MSBuildThisFileDirectory)../docs/icon.png" Pack="true" Visible="false" PackagePath="\" />
  </ItemGroup>

  <!--
    A package that uses internals of SolTechnology.DataLake (InternalsVisibleTo) works only with the core it was built
    with, so it depends on exactly that version: set UsesCoreInternals to true in its project.
  -->
  <Target Name="DependOnExactCoreVersion" AfterTargets="_GetProjectReferenceVersions" Condition="'$(UsesCoreInternals)' == 'true'">
    <ItemGroup>
      <_ExactCoreReference Include="@(_ProjectReferencesWithVersions)" Condition="'%(Filename)' == 'SolTechnology.DataLake'">
        <ProjectVersion>[%(ProjectVersion)]</ProjectVersion>
      </_ExactCoreReference>
      <_ProjectReferencesWithVersions Remove="@(_ExactCoreReference)" />
      <_ProjectReferencesWithVersions Include="@(_ExactCoreReference)" />
    </ItemGroup>
  </Target>
</Project>
