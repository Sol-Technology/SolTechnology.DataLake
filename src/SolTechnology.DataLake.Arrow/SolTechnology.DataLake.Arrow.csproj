<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>SolTechnology.DataLake.Arrow</RootNamespace>
		<AssemblyName>SolTechnology.DataLake.Arrow</AssemblyName>
		<PackageId>SolTechnology.DataLake.Arrow</PackageId>
		<Description>Apache Arrow for SolTechnology.DataLake: record batches, ADBC results (Databricks, Snowflake, BigQuery, Flight SQL) and Arrow IPC files into your classes and back with ArrowConvert, and Arrow IPC files (.arrow, .feather, .ipc, .arrows) in folder datasets with f.Arrow() in UseFiles. $(LicenceSummary)</Description>
		<PackageTags>arrow apache-arrow adbc flight-sql feather parquet lakehouse datalake</PackageTags>
		<UsesCoreInternals>true</UsesCoreInternals>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Apache.Arrow" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\SolTechnology.DataLake\SolTechnology.DataLake.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SolTechnology.DataLake.UnitTests" />
		<InternalsVisibleTo Include="datalake" />
	</ItemGroup>

</Project>
