<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>SolTechnology.DataLake</RootNamespace>
		<AssemblyName>SolTechnology.DataLake</AssemblyName>
		<PackageId>SolTechnology.DataLake</PackageId>
		<Description>Read Parquet and Avro datasets (and soon Apache Iceberg tables) from .NET into your own classes. No Spark, no JVM. Hive partitions, LINQ filters that skip files and row groups, nested columns, timestamps through SolTechnology.DateTimeZone. $(LicenceSummary)</Description>
		<PackageTags>iceberg apache-iceberg parquet avro lakehouse datalake data-lake dataset partitions</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="AvroConvert" />
		<PackageReference Include="Parquet.Net" />
		<PackageReference Include="SolTechnology.DateTimeZone" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SolTechnology.DataLake.UnitTests" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.IntegrationTests" />
		<InternalsVisibleTo Include="datalake" />
	</ItemGroup>

</Project>
