<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>SolTechnology.DataLake</RootNamespace>
		<AssemblyName>SolTechnology.DataLake</AssemblyName>
		<PackageId>SolTechnology.DataLake</PackageId>
		<Description>Read and write Parquet datasets (and soon Apache Iceberg tables) from .NET with your own classes. No Spark, no JVM. Hive partitions, LINQ filters that skip files and row groups, nested columns, Apache Arrow and ADBC results into classes, timestamps through SolTechnology.DateTimeZone. $(LicenceSummary)</Description>
		<PackageTags>iceberg apache-iceberg parquet avro arrow adbc lakehouse datalake data-lake dataset partitions</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Apache.Arrow" />
		<PackageReference Include="AvroConvert" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Parquet.Net" />
		<PackageReference Include="SolTechnology.DateTimeZone" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SolTechnology.DataLake.UnitTests" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.IntegrationTests" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.CompatibilityTests" />
		<InternalsVisibleTo Include="datalake" />
	</ItemGroup>

</Project>
