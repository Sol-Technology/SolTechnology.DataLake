<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>SolTechnology.DataLake</RootNamespace>
		<AssemblyName>SolTechnology.DataLake</AssemblyName>
		<PackageId>SolTechnology.DataLake</PackageId>
		<Description>Read and write Parquet datasets from .NET with your own classes, like EF Core for a data lake. No Spark, no JVM. A LakeContext with datasets as folders of files, hive partitions, LINQ filters that skip files and row groups, nested columns, timestamps through SolTechnology.DateTimeZone, local disk and memory. S3, Azure, Arrow and Avro come as separate packages. $(LicenceSummary)</Description>
		<PackageTags>parquet lakehouse datalake data-lake dataset partitions iceberg apache-iceberg</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
		<PackageReference Include="Parquet.Net" />
		<PackageReference Include="SolTechnology.DateTimeZone" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="SolTechnology.DataLake.UnitTests" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.IntegrationTests" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.CompatibilityTests" />
		<InternalsVisibleTo Include="datalake" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.Arrow" />
		<InternalsVisibleTo Include="SolTechnology.DataLake.Avro" />
	</ItemGroup>

</Project>
