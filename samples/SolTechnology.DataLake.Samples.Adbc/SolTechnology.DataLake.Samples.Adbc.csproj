<Project Sdk="Microsoft.NET.Sdk">

	<!-- Query results from Databricks SQL and Snowflake into classes, through ADBC. Flight SQL is its own sample (SolTechnology.DataLake.Samples.FlightSql). See README.md. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Apache.Arrow.Adbc.Drivers.Databricks" />
		<PackageReference Include="Apache.Arrow.Adbc.Drivers.Interop.Snowflake" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\SolTechnology.DataLake.Arrow\SolTechnology.DataLake.Arrow.csproj" />
	</ItemGroup>

</Project>
