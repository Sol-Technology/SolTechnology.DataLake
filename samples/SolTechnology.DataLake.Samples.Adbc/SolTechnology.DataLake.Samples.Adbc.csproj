<Project Sdk="Microsoft.NET.Sdk">

	<!-- Query results from Databricks SQL, Snowflake and Flight SQL servers into classes, through ADBC. See README.md. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Apache.Arrow.Adbc.Drivers.Databricks" />
		<PackageReference Include="Apache.Arrow.Adbc.Drivers.FlightSql" />
		<PackageReference Include="Apache.Arrow.Adbc.Drivers.Interop.Snowflake" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\SolTechnology.DataLake\SolTechnology.DataLake.csproj" />
	</ItemGroup>

</Project>
