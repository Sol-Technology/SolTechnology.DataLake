<Project Sdk="Microsoft.NET.Sdk">

	<!-- Query results from any Arrow Flight SQL server into classes, through the ADBC Flight SQL driver. Run against GizmoSQL by the integration tests. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Apache.Arrow.Adbc.Drivers.Interop.FlightSql" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\SolTechnology.DataLake\SolTechnology.DataLake.csproj" />
	</ItemGroup>

</Project>
